# Copy this file to .env and fill in real values. Never commit .env.

# --- Database ---
# PostgreSQL connection string, using the psycopg3 driver.
DATABASE_URL=postgresql+psycopg://kilkaari_user:changeme@localhost:5432/kilkaari

# --- Auth ---
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=replace-with-a-long-random-secret
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# --- First admin account (created automatically on first startup if missing) ---
FIRST_ADMIN_EMAIL=admin@kilkaari.org.in
FIRST_ADMIN_PASSWORD=change-this-immediately
FIRST_ADMIN_NAME=Kilkaari Admin

# --- CORS ---
# Local dev: CORS_ORIGINS=* is fine (accepts any origin — convenient since
# local dev servers use unpredictable ports/hostnames).
# PRODUCTION: replace with an explicit comma-separated list of your real
# deployed URLs, e.g.:
#   CORS_ORIGINS=https://kilkaari.org,https://admin.kilkaari.org
# Never use * in production — it lets any website call your API.
CORS_ORIGINS=*

# --- Payments ---
# This backend ships with a "test" payment provider that always succeeds,
# so the donation flow works end-to-end before you wire up a real gateway.
# Set PAYMENT_PROVIDER=razorpay or PAYMENT_PROVIDER=instamojo and fill in
# the matching keys once you're ready to accept real payments.
PAYMENT_PROVIDER=test
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
INSTAMOJO_API_KEY=
INSTAMOJO_AUTH_TOKEN=
